# AgriConnect Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cluster URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/agriconnect?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas cluster credentials:
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect

# JWT Authentication
JWT_SECRET=agriconnect_jwt_secret_key_prod_quality_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:3000
